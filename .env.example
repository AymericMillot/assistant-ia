NODE_ENV=production
PORT=3000
# Port hote optionnel du profil Docker "frontend-dev" (le backend de
# production continue d'ecouter sur PORT).
FRONTEND_DEV_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_ACCESS_MODE=any
SERVER_BIND_HOST=0.0.0.0
PROJECT_WORKSPACE_DIR=
# Socket du moteur Docker monte dans le service de mise a jour. Vide =
# /var/run/docker.sock. Detecte automatiquement par install.sh/restart.sh
# (Docker rootless, Podman).
DOCKER_SOCKET_PATH=
# Identite (uid/gid) de l'utilisateur proprietaire du projet sur le serveur.
# Le backend ecrit uploads/logs/data sous cette identite (et non en root) :
# aucune commande sudo n'est necessaire pour mettre a jour ou nettoyer le
# projet. Rempli automatiquement par install.sh ; vide = proprietaire du
# dossier backend/data.
APP_UID=
APP_GID=
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=30
ADMIN_RATE_LIMIT_PER_MINUTE=180
# --- Secrets (a garder prives, jamais commit avec de vraies valeurs) ---
JWT_SECRET=changeme_secret_jwt_tres_long
# Cle de chiffrement au repos des secrets stockes en base (FTP, export...).
# Generee automatiquement par install.sh si absente ; a garder stable et privee.
CONFIG_ENCRYPTION_KEY=
# Valeur locale générée automatiquement à l'installation lorsqu'elle est
# absente. Ne jamais mettre une vraie valeur dans ce fichier versionné ni dans
# un export.
OWNER_BOOTSTRAP_PASSWORD=
SQLITE_PATH=./data/assistant-ia.sqlite
OLLAMA_URL=http://ollama:11434
CHROMA_URL=http://chromadb:8000
REDIS_URL=redis://redis:6379
DEFAULT_MODEL=gemma4:e4b
EMBEDDING_MODEL=embeddinggemma-2:740m
OLLAMA_FALLBACK_MODELS=llama3.2:3b
OLLAMA_NUM_THREAD=
OLLAMA_NUM_GPU=
# Fenetre de contexte (num_ctx). Vide = automatique pour chaque modele :
# maximum du modele, borne par la memoire disponible pour son cache KV et par
# OLLAMA_AUTO_CTX_MAX. Une valeur ici force un plafond pour tous les modeles.
OLLAMA_NUM_CTX=
OLLAMA_AUTO_CTX_MAX=32768
# Memoire (Gio) utilisable par Ollama pour un modele + son contexte. Vide =
# 60 % de la RAM de l'hote. A renseigner avec la VRAM sur un serveur GPU.
OLLAMA_MEMORY_BUDGET_GB=
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
# 2 = le modele de conversation et le modele d'embedding restent charges
# ensemble. Avec 1, chaque question dechargeait le modele de conversation pour
# calculer l'embedding puis le rechargeait (plusieurs secondes par question).
# Ollama ne garde deux modeles que s'ils tiennent en memoire ; sinon il decharge.
OLLAMA_MAX_LOADED_MODELS=2
# Actualisation mensuelle du catalogue de modeles suggeres : par defaut, va
# chercher directement les modeles disponibles sur ollama.com/library. Definir
# MODEL_CATALOG_SOURCE_URL pour utiliser a la place un fichier JSON prive/
# curatoriale (meme forme que le catalogue statique).
MODEL_CATALOG_SOURCE_URL=
MODEL_CATALOG_REFRESH_TIMEOUT_MS=10000
OLLAMA_LIBRARY_TIMEOUT_MS=15000
RAG_INDEX_BATCH_SIZE=8
RAG_EMBEDDING_REQUEST_BATCH_SIZE=8
FILESYSTEM_SYNC_COOLDOWN_MS=2000
DOCUMENT_UPLOAD_MAX_BYTES=104857600
DOCUMENT_UPLOAD_MAX_FILES=20
XLSX_MAX_SHEETS=30
XLSX_MAX_ROWS_PER_SHEET=20000
XLSX_MAX_CELLS_PER_ROW=200
RAG_TOP_K=5
MIN_VECTOR_RELEVANCE_SCORE=0.22
MIN_DOCUMENT_OVERLAP_SCORE=0.12
MIN_MANUAL_OVERLAP_SCORE=0.12
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_CONTEXT_CHARACTERS=7000
# Query expansion : reformulations automatiques de la question (synonymes,
# tournures) generees par le modele actif pour elargir la recherche vectorielle.
RAG_QUERY_EXPANSION_ENABLED=true
RAG_QUERY_EXPANSION_MAX=4
# Bornes de cette etape (un appel au modele avant chaque reponse) : longueur
# maximale generee et delai au-dela duquel la recherche continue sans elle.
RAG_QUERY_EXPANSION_MAX_TOKENS=160
RAG_QUERY_EXPANSION_TIMEOUT_MS=10000
MANUAL_RESOURCE_PROMPT_LIMIT=4
# Memoire de conversation : nombre maximal de messages repris mot pour mot.
# Le budget reel suit la fenetre de contexte du modele ; les echanges plus
# anciens (ou qui ne tiennent pas) sont resumes au lieu d'etre oublies.
CHAT_HISTORY_LIMIT=20
OLLAMA_TEMPERATURE=0.3
# Indexation visuelle des PDF : les pages illustrees ou scannees sont decrites
# par le modele "image" (onglet Modeles) ou, a defaut, par le modele de
# conversation s'il lit les images. Descriptions mises en cache par fichier.
PDF_VISION_ENABLED=true
# true = analyser toutes les pages (utile pour des plans/schemas vectoriels).
PDF_VISION_ALL_PAGES=false
PDF_VISION_MAX_PAGES=40
PDF_VISION_MIN_IMAGE_PX=80
PDF_VISION_RENDER_WIDTH=1280
PDF_VISION_PAGE_TIMEOUT_MS=300000
OLLAMA_VISION_KEEP_ALIVE=5m
AUTO_INDEX_ENABLED=true
INACTIVITY_THRESHOLD_MINUTES=30
QUEUE_TIMEOUT_MS=300000

# Pieces jointes du chat (txt, md, csv, log, pdf, docx, xlsx) : taille max par
# fichier, retention avant suppression automatique si un referent ne les a pas
# triees, texte injecte dans le prompt (par fichier / au total), texte maximal
# extrait d'un fichier, quota global et espace disque libre minimal.
USER_ATTACHMENT_MAX_BYTES=5242880
USER_ATTACHMENT_RETENTION_DAYS=30
USER_ATTACHMENT_PROMPT_MAX_CHARS=8000
USER_ATTACHMENT_PROMPT_TOTAL_MAX_CHARS=16000
USER_ATTACHMENT_MAX_CHARS=300000
USER_ATTACHMENT_STORAGE_QUOTA_BYTES=524288000
USER_ATTACHMENT_MIN_FREE_DISK_BYTES=524288000
CHAT_ATTACHMENT_RATE_LIMIT=12
ATTACHMENT_CLEANUP_INTERVAL_MS=21600000

# Evaluation des reponses par les utilisateurs (pouces dans le chat).
CHAT_RATING_RATE_LIMIT=40
RATING_SIGNAL_MIN_SCORE=0.34
RATING_SIGNAL_MAX_EXAMPLES=2

# Scraping des liens documentaires (analyse du contenu des sites ajoutes en admin).
WEB_SCRAPE_TIMEOUT_MS=20000
WEB_SCRAPE_MAX_BYTES=3145728
WEB_SCRAPE_MAX_CHARS=200000
# Mettre a 1 uniquement si la documentation a indexer est hebergee sur le reseau local.
WEB_SCRAPE_ALLOW_PRIVATE=0
UPLOADS_DIR=./uploads
LOGS_DIR=./logs
LOG_LEVEL=info
# Rotation des journaux (app.log, error.log, indexation.log) : taille max d'un
# fichier en Mo et nombre de fichiers conserves.
LOG_MAX_SIZE_MB=20
LOG_MAX_FILES=5

# Proxy sortant (site universitaire/lycee derriere un proxy d'etablissement).
# Renseigner si l'acces a Internet passe obligatoirement par un proxy : la
# verification des mises a jour et le telechargement des releases GitHub par
# le conteneur updater les utiliseront (NODE_USE_ENV_PROXY=1 est deja fixe
# cote updater). Laisser vide en acces direct.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,updater,backend,ollama,chromadb,redis
FRONTEND_DIST_DIR=./public
UPDATER_URL=http://updater:3010
# Jeton partage backend <-> updater (genere automatiquement par ./install.sh).
# Authentifie les operations privilegiees de mise a jour sur le reseau Docker
# interne. Laisser vide desactive ce controle (installations historiques).
UPDATER_SHARED_TOKEN=
# Jeton GitHub (scope public_repo suffit) : releve la limite de l'API GitHub de
# 60 a 5000 requetes/heure. Recommande si plusieurs installations partagent la
# meme IP publique (NAT d'etablissement) et voient des erreurs 403.
UPDATE_GITHUB_TOKEN=
# Plafond DUR d'appels a l'API GitHub par 24 h pour la verification des mises a
# jour (defaut 10), toutes sources confondues : polling admin, page /release
# publique, verification planifiee. Le resultat est mis en cache sur disque et
# reservi entre deux appels. Ne descendez pas trop bas : en dessous de ~2 le
# delai de detection d'une nouvelle version depasse 12 h.
UPDATE_GITHUB_MAX_CALLS_PER_DAY=10
# Webhooks Discord pour la zone publique "Signaler un bug / Suggestion" du
# chat. Laisser vide desactive le canal correspondant (le formulaire renvoie
# une erreur explicite plutot que d'echouer silencieusement).
DISCORD_WEBHOOK_BUG_URL=
DISCORD_WEBHOOK_SUGGESTION_URL=
FEEDBACK_RATE_LIMIT=10

SUPPORT_NOTIFICATION_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Les mots de passe de comptes sont stockés en base avec bcrypt, pas en clair.

# Publication des mises à jour.
# Prefer configurer ces identifiants depuis l'admin (chiffres en base avec
# CONFIG_ENCRYPTION_KEY) plutot qu'ici : ces variables ne servent plus que de
# secours si rien n'est configure cote admin. Ces identifiants restent cote
# serveur : jamais exposes au frontend, jamais inclus dans les exports.
DEPLOY_FTP_HOST=
DEPLOY_FTP_USER=
DEPLOY_FTP_PASSWORD=
DEPLOY_FTP_REMOTE_DIR=
DEPLOY_PUBLIC_BASE_URL=
# Optionnel : dossier distant recevant assistant-ia.zip (toujours la derniere version,
# nom fixe), pour l'installation web en une commande (irm ... | iex cote Windows,
# voir web-install.ps1). Par defaut, calcule automatiquement comme le dossier
# parent de DEPLOY_FTP_REMOTE_DIR (ex: "iutlab/maj" -> "iutlab") : ne renseigner
# que si l'arborescence distante reelle est differente.
DEPLOY_LATEST_ZIP_DIR=
