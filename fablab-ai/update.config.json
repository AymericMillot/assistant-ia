{
  "server": {
    "type": "http",
    "baseUrl": "https://maj.aymericmillot.com/iutlab/maj",
    "releaseLayout": "version-directories",
    "versionFile": "version.json",
    "packageFile": "",
    "packageFileTemplate": "fablab-ai-v{version}.tar.gz",
    "notesFile": "release-notes.txt",
    "requireSha256": true,
    "headers": {}
  },
  "apply": {
    "services": ["backend", "updater"],
    "preservePaths": [
      ".env",
      "update.config.json",
      "backend/uploads",
      "backend/logs",
      "backend/data"
    ]
  }
}
