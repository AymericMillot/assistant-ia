# Copier ce fichier vers .env.publish puis renseigner les identifiants.
# .env.publish est ignoré par git et ne doit jamais être commité.
#
# Ces identifiants ne servent qu'à publier une nouvelle version depuis le poste
# développeur (script publish-release.sh) vers votre propre serveur de mise à
# jour (voir update.config.json et docs/CONFIGURATION.md). Ils peuvent aussi
# être configurés depuis l'admin (page "Export et déploiement"), chiffrés en
# base plutôt qu'en clair ici.

FTP_HOST="votre-hote-ftp.example.com"
FTP_USER="votre-utilisateur-ftp"
FTP_PASSWORD="CHANGEZ-MOI"

# Dossier distant correspondant à l'URL publique ci-dessous.
FTP_REMOTE_DIR="chemin/vers/le/dossier/de/publication"

# URL publique de vérification après publication.
PUBLIC_BASE_URL="https://votre-serveur-de-maj.example.com/chemin"
