{
  "server": {
    "type": "github-releases",
    "repository": "AymericMillot/assistant-ia",
    "apiBaseUrl": "",
    "latestReleaseUrl": "https://github.com/AymericMillot/assistant-ia/releases/latest",
    "releaseLayout": "github-releases",
    "manifestFileTemplate": "fablab-ai-v{version}.manifest.json",
    "packageFileTemplate": "fablab-ai-v{version}.tar.gz",
    "requireSha256": true,
    "headers": {}
  },
  "apply": {
    "services": ["backend", "updater"],
    "preservePaths": [
      ".env",
      "update.config.json",
      "backend/uploads",
      "backend/logs",
      "backend/data"
    ]
  }
}
